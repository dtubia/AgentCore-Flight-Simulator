    {
      "id": "policy-engine-enterprise",
      "type": "policy_engine",
      "displayName": "Policy Engine",
      "mode": "ENFORCE",
      "policies": [
        {
          "id": "allow-drive-search",
          "effect": "allow",
          "principal": "travel-expense-agent",
          "action": "google_drive.search_files",
          "condition": "context.scopes.includes('https://www.googleapis.com/auth/drive.readonly')"
        },
        {
          "id": "allow-drive-readonly",
          "effect": "allow",
          "principal": "travel-expense-agent",
          "action": "google_drive.read_file",
          "condition": "context.scopes.includes('https://www.googleapis.com/auth/drive.readonly')"
        }
      ],
      "position": {
        "x": 860,
        "y": 340
      }
    },
    {
      "id": "external-google-drive",
