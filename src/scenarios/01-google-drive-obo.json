      "endpoint": "https://mcp.google-drive-adapter.example.local/mcp",
      "auth": {
        "type": "OAuth2",
        "mode": "on_behalf_of",
        "credentialProviderName": "google-drive-obo"
      },
      "tools": [
        {
          "name": "google_drive.search_files",
          "description": "Search files visible to the authenticated user",
          "requiredScopes": [
            "https://www.googleapis.com/auth/drive.metadata.readonly"
          ],
          "inputSchema": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string"
              },
              "mimeType": {
                "type": "string"
              }
            },
            "required": [
              "query"
            ]
          }
        },
        {
          "name": "google_drive.read_file",
          "description": "Read a file visible to the authenticated user",
          "requiredScopes": [
            "https://www.googleapis.com/auth/drive.readonly"
          ],
          "inputSchema": {
            "type": "object",
            "properties": {
              "fileId": {
                "type": "string"
              }
            },
            "required": [
              "fileId"
            ]
          }
        },
        {
          "name": "google_drive.export_file",
          "description": "Export a Drive file",
          "requiredScopes": [
            "https://www.googleapis.com/auth/drive.file"
          ],
          "inputSchema": {
            "type": "object",
            "properties": {
              "fileId": {
                "type": "string"
              },
              "mimeType": {
                "type": "string"
              }
            },
            "required": [
              "fileId"
            ]
          }
        }
      ],
      "errors": [
        "401 invalid_token",
        "403 insufficient_scope",
        "404 file_not_found",
        "429 rate_limit_exceeded"
      ],
