      "authMode": "OAUTH_JWT"
    },
    {
      "id": "e-runtime-gateway",
      "source": "agent-travel",
      "target": "gateway-enterprise-tools",
      "kind": "runtime_to_gateway_mcp",
      "authMode": "OAUTH_JWT"
    },
    {
      "id": "e-gateway-policy",
      "source": "gateway-enterprise-tools",
      "target": "policy-engine-enterprise",
      "kind": "gateway_to_policy_engine"
    },
    {
      "id": "e-gateway-workday",
      "source": "gateway-enterprise-tools",
      "target": "external-workday",
      "kind": "gateway_to_mcp_target"
    },
    {
      "id": "e-runtime-identity",
      "source": "agent-travel",
      "target": "identity-default",
      "kind": "runtime_to_identity"
    },
    {
      "id": "e-gateway-identity",
      "source": "gateway-enterprise-tools",
      "target": "identity-default",
      "kind": "gateway_to_identity"
    },
    {
      "id": "e-identity-keycloak-workday",
      "source": "identity-default",
      "target": "idp-keycloak",
      "kind": "identity_to_authorization_server",
      "label": "Provider: workday-custom",
      "credentialProviderName": "workday-custom",
      "credentialProviderFlow": "CLIENT_CREDENTIALS"
    }
  ],
  "initialUserPrompt": "Get the compensation details for worker W-1001.",
  "mutations": [
    {
      "id": "request_sensitive_workday",
      "label": "Sensitive Workday data",
      "description": "Call compensation without correct scope.",
      "target": "policy",
      "enabled": true,
      "expectedFinding": "Policy denies sensitive access."
    }
  ],
  "expectedLearningOutcomes": [
    "Tool listing does not guarantee tool call authorization.",
    "Call-time context controls sensitive SaaS data."
  ]
}
