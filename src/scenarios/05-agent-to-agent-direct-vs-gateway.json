          ],
          "allowedResources": [
            "arn:aws:bedrock-agentcore:us-west-2:123456789012:runtime/policy-review-agent-abcd123456"
          ]
        },
        "forwardedOAuthToken": {
          "enabled": true,
          "headerName": "X-AgentCore-Forwarded-OAuth-Token",
          "required": true,
          "validateAsUserContext": true,
          "description": "Custom OAuth context header carried alongside SigV4."
        }
      },
      "workloadIdentity": {
        "name": "policy-review-agent",
        "arn": "arn:aws:bedrock-agentcore:us-west-2:123456789012:workload-identity-directory/default/workload-identity/policy-review-agent"
