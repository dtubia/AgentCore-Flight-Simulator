      "qualifier": "DEFAULT",
      "protocol": "HTTP",
      "inboundAuth": {
        "mode": "OAUTH_JWT",
        "allowedIssuers": [
          "https://keycloak.example.local/realms/agentcore-lab"
        ],
        "allowedAudiences": [
          "agentcore-runtime:travel-expense-agent"
