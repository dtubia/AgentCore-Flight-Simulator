{
  "schemaVersion": "1.0",
  "id": "05-agent-to-agent-direct-vs-gateway",
  "name": "Agent-to-agent direct A2A versus Gateway HTTP target",
  "description": "Compares direct A2A with a Gateway-mediated Runtime HTTP target signed with SigV4 and a custom forwarded OAuth context header.",
