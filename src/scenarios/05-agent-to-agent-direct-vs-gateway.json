      "workloadIdentity": {
        "name": "travel-expense-agent",
        "arn": "arn:aws:bedrock-agentcore:us-west-2:123456789012:workload-identity-directory/default/workload-identity/travel-expense-agent"
      },
      "session": {
        "runtimeSessionId": "alice-expenses-session-000000000001",
        "state": "idle"
      },
      "position": {
        "x": 860,
        "y": 140
      }
    },
    {
      "id": "agent-policy-review",
      "type": "agentcore_runtime_agent",
      "displayName": "PolicyReviewAgent",
      "name": "PolicyReviewAgent",
      "runtimeArn": "arn:aws:bedrock-agentcore:us-west-2:123456789012:runtime/policy-review-agent-abcd123456",
      "qualifier": "DEFAULT",
      "protocol": "A2A",
      "inboundAuth": {
        "mode": "AWS_IAM_SIGV4",
        "sigv4": {
          "region": "us-west-2",
          "service": "bedrock-agentcore",
          "principalArn": "arn:aws:iam::123456789012:role/AgentCoreGatewayRuntimeInvokeRole",
          "allowedActions": [
