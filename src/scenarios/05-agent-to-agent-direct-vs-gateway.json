      "inboundAuth": {
        "mode": "AWS_IAM_SIGV4",
        "sigv4": {
          "region": "us-west-2",
          "service": "bedrock-agentcore",
          "principalArn": "arn:aws:iam::123456789012:role/TravelExpenseAgentRuntimeRole",
          "allowedActions": [
            "bedrock-agentcore:InvokeGateway"
