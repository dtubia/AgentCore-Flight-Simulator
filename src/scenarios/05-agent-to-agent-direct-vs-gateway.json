        "forwardedOAuthToken": {
          "enabled": true,
          "headerName": "X-AgentCore-Inbound-OAuth-Token",
          "required": true,
          "validateAsUserContext": true,
          "description": "Carries the original inbound OAuth token when Authorization is occupied by SigV4."
        }
      },
      "policyMode": "ENFORCE",
      "semanticSearchEnabled": true,
      "position": {
        "x": 1140,
        "y": 140
      }
    },
    {
      "id": "policy-engine-enterprise",
      "type": "policy_engine",
